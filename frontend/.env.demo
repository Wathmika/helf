# `npm run dev:demo` (vite --mode demo): the same website with the sample
# family and no backend. Blank values override .env, so lib/supabase.ts
# sees Supabase as not configured and every screen uses lib/demoStore.ts.
# Holds no secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BACKEND_API_URL=
VITE_SCAN_PAGE_ORIGIN=
