# Copy this file to .env and fill in the real values from Wathmika.
# Anon/publishable key only — never the service_role/secret key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where printed QR codes point: the backend's public scan domain, e.g.
# https://helf.lk (no trailing slash). Not decided yet — a printed QR can
# never change, so the QR codes screen shows no codes until this is set.
VITE_SCAN_PAGE_ORIGIN=

# Demo mode only (no Supabase): the sample scan page QRs open. Defaults to
# this site's own copy at <origin>/scan.html (public/scan.html).
# VITE_DEMO_SCAN_URL=

# The backend's address (the SAM stack's ApiUrl output), for the one call
# this app makes to it: POST /account/delete. The backend's APP_ORIGINS
# (CORS) must include this app's address.
VITE_BACKEND_API_URL=
